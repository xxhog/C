@{ViewData["Title"]="Личный кабинет";}
<section class="page-hero"><div class="wrap"><span class="eyebrow">ЛИЧНЫЙ КАБИНЕТ</span><h1>Здравствуйте, @Context.Session.GetString("UserName")!</h1><p>@Context.Session.GetString("UserEmail") · @Context.Session.GetString("Role")</p><a class="text-link" asp-action="Edit">Изменить имя →</a> &nbsp; <a class="text-link" asp-action="Logout">Выйти из аккаунта →</a></div></section><section class="section wrap"><h2>История заказов</h2>@if(((IEnumerable<HomeCakes.Models.ShopOrder>)ViewBag.Orders).Any()){<div class="table-wrap"><table><tr><th>№</th><th>Состав</th><th>Сумма</th><th>Статус</th></tr>@foreach(var order in (IEnumerable<HomeCakes.Models.ShopOrder>)ViewBag.Orders){<tr><td>@order.Id</td><td>@order.Items</td><td>@order.Total.ToString("N0") ₽</td><td>@order.Status</td></tr>}</table></div>}else{<div class="empty-state"><p>Заказов пока нет.</p><a asp-controller="Catalog" asp-action="Index" class="button">Выбрать торт</a></div>}</section>
