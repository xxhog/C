@model List<HomeCakes.Models.Cake>
@{ViewData["Title"]="Каталог тортов";}
<section class="page-hero"><div class="wrap"><span class="eyebrow">ТОРТЫ РУЧНОЙ РАБОТЫ В ИЖЕВСКЕ</span><h1>Каталог тортов</h1><p>Каждый торт готовим вручную после оформления заказа. Доставляем по Ижевску.</p></div></section><section class="section wrap"><form class="filters" method="get"><label>Категория<select name="category" onchange="this.form.submit()"><option value="">Все торты</option>@foreach(string category in ViewBag.Categories){<option value="@category" selected="@(Context.Request.Query["category"]==category)">@category</option>}</select></label><label>Сортировка<select name="sort" onchange="this.form.submit()"><option value="">По популярности</option><option value="price" selected="@(Context.Request.Query["sort"]=="price")">Сначала дешевле</option><option value="name" selected="@(Context.Request.Query["sort"]=="name")">По названию</option></select></label></form><div class="cards">@foreach(var cake in Model){<article class="cake-card"><img src="@cake.Image" alt="@cake.Name"/><div class="cake-info"><span class="tag">@cake.Category</span><h3>@cake.Name</h3><p>@cake.Description</p><div class="card-bottom"><strong>@cake.Price.ToString("N0") ₽</strong><form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="id" value="@cake.Id"/><button class="button small">Добавить</button></form></div></div></article>}</div><div class="filling-note"><h3>Добавьте начинку</h3><p>Можно обсудить дополнительные начинки с кондитером при подтверждении заказа:</p><div class="chips">@foreach(string filling in ViewBag.Fillings){<span>@filling</span>}</div></div></section>
