@model List<HomeCakes.Models.Cake>
@{ViewData["Title"]="Домашние торты с доставкой по Ижевску";}
<section class="hero"><div class="wrap hero-inner"><div class="hero-copy"><span class="eyebrow">ТЕПЛО ДОМАШНЕЙ ВЫПЕЧКИ</span><h1>Праздник в Ижевске начинается<br/>с любимого торта</h1><p>Готовим вручную из натуральных ингредиентов — для семейных встреч и важных событий.</p><a class="button" asp-controller="Catalog" asp-action="Index">Выбрать торт <span>→</span></a><div class="hero-note">✦ Свежая выпечка каждый день</div></div><div class="hero-picture"><img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=1100&q=85" alt="Праздничный торт"/><div class="round-label">сделано<br/>с любовью</div></div></div></section>
<section class="section wrap"><div class="section-head"><div><span class="eyebrow">ПОПУЛЯРНОЕ</span><h2>Выбирают чаще всего</h2></div><a class="text-link" asp-controller="Catalog" asp-action="Index">Весь каталог →</a></div><div class="cards">@foreach(var cake in Model){<article class="cake-card"><img src="@cake.Image" alt="@cake.Name"/><div class="cake-info"><span class="tag">@cake.Category</span><h3>@cake.Name</h3><p>@cake.Description</p><div class="card-bottom"><strong>@cake.Price.ToString("N0") ₽</strong><form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="id" value="@cake.Id"/><button class="button small">В корзину</button></form></div></div></article>}</div></section>
<section class="about-band"><div class="wrap two-col"><div><span class="eyebrow">О НАС В ИЖЕВСКЕ</span><h2>Рецепты, которые<br/>собирают близких</h2></div><div><p>Мы — небольшая ижевская кондитерская, где каждый торт готовится вручную. Используем понятные ингредиенты, проверенные рецепты и внимательно относимся к каждому заказу.</p><a class="text-link" asp-controller="Home" asp-action="About">Познакомиться с нами →</a></div></div></section>
<section class="section wrap builder"><div><span class="eyebrow">ВАШ ИДЕАЛЬНЫЙ ТОРТ</span><h2>Соберите свой вкус</h2><p>Выберите основу в каталоге и добавьте любимую начинку. Расскажите о пожеланиях при оформлении заказа — мы поможем с деталями.</p><a class="button" asp-controller="Catalog" asp-action="Index">Подобрать торт</a></div><div class="builder-art">🍰<span>Вы + наши рецепты<br/>= идеальный десерт</span></div></section>
<section class="delivery"><div class="wrap delivery-inner"><div><span class="eyebrow">БЕРЕЖНО ДОСТАВИМ ПО ИЖЕВСКУ</span><h2>Торт приедет<br/>точно к празднику</h2><p>Доставляем по Ижевску в удобный для вас интервал. Курьер привезёт заказ аккуратно упакованным.</p><a class="button light" asp-controller="Catalog" asp-action="Index">Заказать доставку</a></div><div class="delivery-icon">🚲</div></div></section>
<section class="section wrap"><div class="section-head"><div><span class="eyebrow">ТЁПЛЫЕ СЛОВА</span><h2>Что говорят покупатели</h2></div><a class="text-link" asp-controller="Reviews" asp-action="Index">Все отзывы →</a></div><div class="quote-grid"><blockquote>“Очень вкусный торт, красивое оформление и доставка вовремя!”<cite>— Анна</cite></blockquote><blockquote>“Заказывали на день рождения. Гости попросили контакты кондитера.”<cite>— Ирина</cite></blockquote></div></section>
<section class="contact-strip"><div class="wrap two-col"><div><span class="eyebrow">МЫ НА СВЯЗИ В ИЖЕВСКЕ</span><h2>Есть вопрос или идея?</h2><p>Позвоните нам — поможем выбрать торт и рассчитать размер.</p></div><div class="contact-quick"><a href="tel:+73412000000">+7 (3412) 00-00-00</a><a asp-controller="Home" asp-action="Contacts">Контакты и обратная связь →</a></div></div></section>
