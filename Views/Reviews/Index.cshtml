@model List<HomeCakes.Models.Review>
@{ViewData["Title"]="Отзывы";}
<section class="page-hero"><div class="wrap"><span class="eyebrow">НАШИ ПОКУПАТЕЛИ</span><h1>Отзывы</h1><p>Спасибо, что делитесь впечатлениями и помогаете нам становиться лучше.</p></div></section><section class="section wrap review-layout"><div><h2>Тёплые слова</h2><div class="review-list">@foreach(var item in Model){<article class="review-card"><div class="stars">@string.Concat(Enumerable.Repeat("★",item.Rating))</div><p>@item.Text</p><b>@item.Name</b></article>}</div></div><form class="form-card" asp-action="Add" method="post"><h2>Оставить отзыв</h2><label>Ваше имя<input name="Name" required/></label><label>Оценка<select name="Rating"><option>5</option><option>4</option><option>3</option><option>2</option><option>1</option></select></label><label>Ваш отзыв<textarea name="Text" required minlength="5" rows="5"></textarea></label><button class="button">Отправить на проверку</button><small>Отзывы публикуются после модерации.</small></form></section>
