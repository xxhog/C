@{ViewData["Title"]="Корзина"; var lines=(IEnumerable<(HomeCakes.Models.Cake? Cake,int Qty)>)ViewBag.Lines; decimal total=0;}
<section class="page-hero"><div class="wrap"><span class="eyebrow">ВАШ ВЫБОР</span><h1>Корзина</h1><p>Проверьте заказ и оставьте данные для доставки по Ижевску.</p></div></section><section class="section wrap cart-layout"><div class="cart-items"><h2>Ваш заказ</h2>@if(!lines.Any()){<div class="empty-state"><span>🧁</span><h3>Корзина пока пуста</h3><p>Выберите торт в каталоге, а мы позаботимся о доставке.</p><a class="button" asp-controller="Catalog" asp-action="Index">Перейти в каталог</a></div>}else{foreach(var line in lines){if(line.Cake!=null){total+=line.Cake.Price*line.Qty;<div class="cart-row"><img src="@line.Cake.Image" alt=""/><div><h3>@line.Cake.Name</h3><p>@line.Qty шт. · @((line.Cake.Price*line.Qty).ToString("N0")) ₽</p></div><form asp-action="Remove" method="post"><input type="hidden" name="id" value="@line.Cake.Id"/><button class="remove" title="Убрать">×</button></form></div>}}}</div>@if(lines.Any()){<form class="form-card checkout" asp-action="Checkout" method="post"><h2>Доставка курьером</h2><p>По Ижевску, точное время согласуем по телефону.</p><label>Телефон<input name="phone" required placeholder="+7 (3412) ___-__-__"/></label><label>Адрес доставки<input name="address" required placeholder="Ижевск, улица, дом, квартира"/></label><div class="total"><span>Итого</span><b>@total.ToString("N0") ₽</b></div><button class="button full">Оформить заказ</button><small>Администратор подтвердит заказ и уточнит детали.</small></form>}</section>

