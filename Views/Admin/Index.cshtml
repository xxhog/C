@{ViewData["Title"]="Управление сайтом"; bool isAdmin=(bool)ViewBag.IsAdmin; var orders=(IEnumerable<HomeCakes.Models.ShopOrder>)ViewBag.Orders; var reviews=(IEnumerable<HomeCakes.Models.Review>)ViewBag.Reviews; var cakes=(IEnumerable<HomeCakes.Models.Cake>)ViewBag.Cakes; var users=(IEnumerable<HomeCakes.Models.ShopUser>)ViewBag.Users;}
<section class="page-hero"><div class="wrap"><span class="eyebrow">АДМИНИСТРАТОР</span><h1>Панель управления</h1><p>Управление заказами, отзывами и содержимым сайта.</p></div></section><section class="section wrap admin-section"><h2>Заказы и доставка</h2>@if(!orders.Any()){<p class="muted">Новых заказов пока нет.</p>}else{<div class="table-wrap"><table><tr><th>№</th><th>Покупатель</th><th>Состав</th><th>Сумма</th><th>Телефон / адрес</th><th>Статус</th></tr>@foreach(var order in orders){<tr><td>@order.Id</td><td>@order.Customer</td><td>@order.Items</td><td>@order.Total.ToString("N0") ₽</td><td>@order.Phone<br/>@order.Address</td><td><form asp-action="Status" method="post"><input type="hidden" name="id" value="@order.Id"/><select name="status" onchange="this.form.submit()">@foreach(string status in new[]{"Новый","Подтверждён","Готовится","Передан курьеру","Доставлен","Отменён"}){<option selected="@(order.Status==status)">@status</option>}</select></form></td></tr>}</table></div>}
<h2 class="admin-sub">Отзывы на модерации</h2>@if(!reviews.Any(r=>!r.IsApproved)){<p class="muted">Новых отзывов нет.</p>}@foreach(var review in reviews.Where(r=>!r.IsApproved)){<div class="admin-row"><div><b>@review.Name</b><p>@review.Text</p></div>@if(isAdmin){<form asp-action="ApproveReview" method="post"><input type="hidden" name="id" value="@review.Id"/><button class="button small">Опубликовать</button></form><form asp-action="DeleteReview" method="post"><input type="hidden" name="id" value="@review.Id"/><button class="remove">×</button></form>}</div>}
@if(isAdmin){<h2 class="admin-sub">Каталог тортов</h2><div class="table-wrap"><table><tr><th>Торт</th><th>Категория</th><th>Цена</th><th></th></tr>@foreach(var cake in cakes){<tr><td>@cake.Name</td><td>@cake.Category</td><td>@cake.Price.ToString("N0") ₽</td><td><form asp-action="DeleteCake" method="post"><input type="hidden" name="id" value="@cake.Id"/><button class="remove">Удалить</button></form></td></tr>}</table></div><form class="inline-form" asp-action="AddCake" method="post"><input name="Name" required placeholder="Название"/><input name="Description" required placeholder="Описание"/><input name="Image" placeholder="URL изображения"/><input name="Category" required placeholder="Категория"/><input name="Price" type="number" min="1" required placeholder="Цена"/><button class="button small">Добавить торт</button></form>
<h2 class="admin-sub">Пользователи и роли</h2><div class="table-wrap"><table><tr><th>Имя</th><th>E-mail</th><th>Роль</th></tr>@foreach(var user in users){<tr><td>@user.Name</td><td>@user.Email</td><td><form asp-action="SetRole" method="post"><input type="hidden" name="email" value="@user.Email"/><select name="role" onchange="this.form.submit()">@foreach(string role in new[]{"Пользователь","Администратор"}){<option selected="@(user.Role==role)">@role</option>}</select></form></td></tr>}</table></div>}
</section>


